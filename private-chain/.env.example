# TLH Private Trust Chain — Environment Variables
# Copy to .env and fill in values before deploying contracts.

# Chain configuration
CHAIN_ID=100100
RPC_URL=http://localhost:8545

# Deployer account (pre-funded in genesis)
DEPLOYER_PRIVATE_KEY=0xac0974bec39a17e36ba4a6b4d238ff944bacb478cbed5efcae784d7bf4f2ff80

# Admin address (receives DEFAULT_ADMIN_ROLE on all contracts)
ADMIN_ADDRESS=0xf39Fd6e51aad88F6F4ce6aB8827279cffFb92266

# Optional: separate admin key for bootstrap (if admin != deployer)
# ADMIN_PRIVATE_KEY=

# Attestation signer address (added to TrustAttestationVerifier via addSigner)
# Must match the EA wallet address (PRIVATE_KEY in external-adapter/.env)
ATTESTATION_SIGNER=0x3B50966A8B71f277e90e14cdC31455F6Af3977e6

# Bootstrap roles on deploy (default: true)
BOOTSTRAP_ROLES=true
