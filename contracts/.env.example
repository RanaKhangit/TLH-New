# TLH Contracts — Environment Variables
# Copy to .env and fill in values before deploying.

# Sepolia RPC URL (e.g. Alchemy, Infura)
SEPOLIA_RPC_URL=https://eth-sepolia.g.alchemy.com/v2/YOUR_API_KEY_HERE

# Etherscan API key (for contract verification)
ETHERSCAN_API_KEY=YOUR_ETHERSCAN_KEY_HERE

# Deployer private key (hex with 0x prefix, must have Sepolia ETH)
DEPLOYER_PRIVATE_KEY=0xYOUR_DEPLOYER_PRIVATE_KEY_HERE

# Admin address (receives DEFAULT_ADMIN_ROLE on all contracts)
ADMIN_ADDRESS=0xYOUR_ADMIN_ADDRESS_HERE
