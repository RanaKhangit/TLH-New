# External Adapter Configuration
EA_PORT=8788

# Prover API URL (local server that verifies DECO attestations)
PROVER_API_URL=http://localhost:8787

# Private key for sending transactions (hex with 0x prefix)
# Must be a funded Sepolia wallet — the deployer address (0x3b50966a...)
PRIVATE_KEY=0x_YOUR_PRIVATE_KEY_HERE

# Sepolia RPC URL (e.g. Alchemy)
SEPOLIA_RPC_URL=https://eth-sepolia.g.alchemy.com/v2/YOUR_API_KEY_HERE
