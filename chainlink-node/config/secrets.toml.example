# Chainlink Node Secrets Configuration
# Copy this file to secrets.toml and fill in your values

# =============================================================================
# Database Configuration
# =============================================================================
[Database]
# Format: postgresql://USER:PASSWORD@HOST:PORT/DATABASE?sslmode=disable
URL = 'postgresql://postgres:YOUR_POSTGRES_PASSWORD@postgres:5432/chainlink?sslmode=disable'

# =============================================================================
# Password Configuration
# =============================================================================
[Password]
# Keystore password for encrypting private keys
# Requirements: 16-50 characters
Keystore = 'YOUR_KEYSTORE_PASSWORD_MIN_16_CHARS'
