# TLH Prover API Configuration
# Copy to .env and update values for your environment

# Server port
PORT=8787

# API authentication token (REQUIRED for protected endpoints)
# Generate a secure random token for production:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
API_TOKEN=your-secure-api-token-here

# Allowed CORS origins (comma-separated)
# Add your frontend and external adapter URLs
ALLOWED_ORIGINS=http://localhost:3001,http://localhost:8788

# Rate limiting configuration
# Window in milliseconds (default: 60000 = 1 minute)
RATE_LIMIT_WINDOW_MS=60000
# Max requests per window (default: 30)
RATE_LIMIT_MAX_REQUESTS=30
